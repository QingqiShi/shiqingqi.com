    "modern-normalize": "^3.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@tuja/tsconfig": "workspace:*",
    "@types/node": "catalog:",
