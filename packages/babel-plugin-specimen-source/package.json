{
  "name": "@tuja/babel-plugin-specimen-source",
  "version": "0.0.0",
  "description": "Babel plugin that reads the original source of every `<Specimen>` and `<UsageSnippet>` and injects it back as a syntax-highlighted token array. Runs first, before any plugin that rewrites the source.",
  "keywords": [
    "babel-plugin",
    "design-system",
    "documentation",
    "syntax-highlighting",
    "jsx"
  ],
  "homepage": "https://github.com/QingqiShi/shiqingqi.com/tree/master/packages/babel-plugin-specimen-source#readme",
  "bugs": {
    "url": "https://github.com/QingqiShi/shiqingqi.com/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingqiShi/shiqingqi.com.git",
    "directory": "packages/babel-plugin-specimen-source"
  },
  "license": "MIT",
  "author": "Qingqi Shi <hi@qingqi.dev>",
  "type": "commonjs",
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "vitest": "catalog:"
  }
}
