{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "GITHUB_STEP_SUMMARY",
    "CI",
    "BASE_URL",
    "ANTHROPIC_API_KEY",
    "TMDB_API_TOKEN",
    "UPSTASH_VECTOR_REST_URL",
    "UPSTASH_VECTOR_REST_TOKEN",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "ALLOWED_DEV_ORIGINS",
    "INIT_CWD",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "SITE_PASSWORD_GB",
    "SITE_PASSWORD_TUSCANY",
    "FINANCE_DATABASE_URL",
    "FINANCE_DATABASE_URL_UNPOOLED",
    "FINANCE_AUTH_SECRET",
    "FINANCE_SETUP_SECRET",
    "FINANCE_CREDENTIAL_KEY",
    "FINANCE_LUNCHFLOW_MODE",
    "FINANCE_RATE_LIMIT",
    "FINANCE_E2E_DB_PORT",
    "FINANCE_PERF",
    "CRON_SECRET"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "codegen": {
      "dependsOn": ["transit"],
      "outputs": [
        "src/_generated/**",
        "public/sw.js",
        "public/pwa-*.png",
        "src/app/manifest.json"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/sw.js",
        "public/pwa-*.png"
      ]
    },
    "build:tsc": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "@tuja/eslint-plugin#transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": [
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "FINANCE_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
