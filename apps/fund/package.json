{
  "name": "fund",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root . --include ../../packages/auth-ui",
    "codegen:wgsl": "node --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root . --include ../../packages/auth-ui --watch",
    "watch:wgsl": "node --watch --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "fonts": "node ../../scripts/fetch-licensed-fonts.mjs",
    "prebuild": "run-p fonts codegen:i18n codegen:wgsl",
    "predev": "run-p \"fonts -- --dev\" codegen:i18n codegen:wgsl",
    "dev": "run-p watch:i18n watch:wgsl dev:next",
    "dev:next": "tsx src/db/dev/run-with-local-fund.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2833) -- next dev --turbopack -p $(node ../../scripts/get-worktree-port.mjs 500)",
    "build": "next build",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm-run-all codegen:i18n codegen:wgsl",
    "test": "vitest run",
    "fund:generate": "drizzle-kit generate",
    "fund:migrate": "tsx src/db/migrate-cli.ts",
    "fund:session": "tsx src/db/dev/session-cli.ts",
    "fund:refresh": "tsx src/fund/market/dev/refresh-cli.ts",
    "fund:meeting": "tsx src/fund/meeting/dev/meeting-cli.ts",
    "fund:replay": "tsx src/fund/meeting/dev/replay-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@phosphor-icons/react": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@tuja/auth-ui": "workspace:*",
    "@tuja/i18n": "workspace:*",
    "@tuja/next-links": "workspace:*",
    "@tuja/server-auth": "workspace:*",
    "@tuja/server-clients": "workspace:*",
    "@tuja/server-db": "workspace:*",
    "@tuja/server-email": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@vercel/functions": "^3.11.3",
    "ai": "^7.0.177",
    "drizzle-orm": "^0.45.4",
    "esm-env": "catalog:",
    "next": "catalog:",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yahoo-finance2": "^4.0.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@electric-sql/pglite": "0.5.16",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/dev-tools": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/test-support": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.11",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
