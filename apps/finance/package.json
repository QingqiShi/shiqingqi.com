{
  "name": "finance",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root .",
    "codegen:wgsl": "node --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root . --watch",
    "watch:wgsl": "node --watch --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "prebuild": "npm-run-all codegen:i18n codegen:wgsl",
    "predev": "npm-run-all codegen:i18n codegen:wgsl",
    "dev": "run-p watch:i18n watch:wgsl dev:next",
    "dev:next": "tsx src/finance/dev/run-with-local-finance.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2433) -- next dev --turbopack -p $(node ../../scripts/get-worktree-port.mjs 200)",
    "build": "next build && serwist build serwist.config.mjs",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm-run-all codegen:i18n codegen:wgsl",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:serve": "PORT=$(node ../../scripts/get-worktree-port.mjs 200) tsx e2e/serve-e2e.ts",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:dev": "vitest --config vitest.eval.config.mts",
    "finance:db": "tsx src/finance/db/dev/serve-dev-db.ts --port $(node ../../scripts/get-worktree-port.mjs 2433)",
    "finance:generate": "drizzle-kit generate",
    "finance:migrate": "drizzle-kit migrate",
    "finance:invite-link": "tsx src/finance/auth/invite-link-cli.ts",
    "finance:seed": "tsx src/finance/dev/seed/cli.ts",
    "finance:seed-demo": "tsx src/finance/dev/seed/cli.ts --demo",
    "finance:session": "tsx src/finance/dev/session/cli.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2433) --app-port $(node ../../scripts/get-worktree-port.mjs 200)",
    "finance:reports:backfill": "tsx src/finance/reports/backfill-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "catalog:",
    "@serwist/next": "catalog:",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "5.105.0",
    "@tuja/i18n": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@typesafe-ai/sdk": "0.7.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.10.3",
    "ai": "^7.0.154",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "catalog:",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.24",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-virtuoso": "^4.18.19",
    "resend": "^6.34.1",
    "serwist": "catalog:",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@electric-sql/pglite": "0.5.12",
    "@next/env": "catalog:",
    "@playwright/test": "^1.64.1",
    "@serwist/cli": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.4",
    "pg-connection-string": "^2.14.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
