{
  "name": "buddy",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root .",
    "codegen:wgsl": "node --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root . --watch",
    "watch:wgsl": "node --watch --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "fonts": "node ../../scripts/fetch-licensed-fonts.mjs",
    "prebuild": "run-p fonts codegen:i18n codegen:wgsl",
    "predev": "run-p \"fonts -- --dev\" codegen:i18n codegen:wgsl",
    "dev": "run-p watch:i18n watch:wgsl dev:next",
    "dev:next": "tsx src/server/dev/run-with-local-buddy.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2633) -- next dev --turbopack -p ${BUDDY_PORT:-$(node ../../scripts/get-worktree-port.mjs 400)}",
    "build": "next build",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm-run-all codegen:i18n codegen:wgsl",
    "test": "vitest run",
    "buddy:generate": "drizzle-kit generate",
    "buddy:migrate": "tsx src/server/db/migrate-cli.ts",
    "buddy:dev-upload": "tsx src/server/dev/dev-upload-cli.ts --port ${BUDDY_PORT:-$(node ../../scripts/get-worktree-port.mjs 400)}",
    "buddy:session": "tsx src/server/dev/session-cli.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2633) --app-port ${BUDDY_PORT:-$(node ../../scripts/get-worktree-port.mjs 400)}"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stylexjs/stylex": "catalog:",
    "@tuja/dev-tools": "workspace:*",
    "@tuja/i18n": "workspace:*",
    "@tuja/next-links": "workspace:*",
    "@tuja/server-auth": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^3.11.0",
    "drizzle-orm": "^0.45.4",
    "next": "catalog:",
    "pg": "^8.23.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@electric-sql/pglite": "0.5.14",
    "@next/env": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/test-support": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.11",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.4",
    "pg-connection-string": "^2.14.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
