{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --watch",
    "watch:props": "tsx ../../packages/props-codegen/src/generator.ts --watch",
    "watch:wgsl": "node --watch --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "fonts": "node ../../scripts/fetch-licensed-fonts.mjs",
    "prebuild": "run-p fonts prebuild:codegen",
    "prebuild:codegen": "npm-run-all codegen:pwa-icons codegen:i18n codegen:palette codegen:props codegen:wgsl",
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts",
    "codegen:palette": "node --experimental-strip-types --no-warnings ../../packages/system-palette-codegen/src/generator.ts && prettier '../../packages/ui/src/_generated/palette/**/*.ts' -w",
    "codegen:props": "tsx ../../packages/props-codegen/src/generator.ts",
    "codegen:pwa-icons": "node ../../packages/pwa-icons/src/generate-hashed-icons.mjs",
    "codegen:tmdb": "node ../../packages/tmdb-codegen/src/generator.js && prettier 'src/_generated/*.ts' 'src/app/api/tmdb/*/route.ts' -w",
    "codegen:wgsl": "node --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "openapi:generate": "openapi-typescript https://developer.themoviedb.org/openapi/tmdb-api.json -o ../../packages/tmdb-types/src/openapi.d.ts && prettier '../../packages/tmdb-types/src/openapi.d.ts' -w",
    "predev": "run-p \"fonts -- --dev\" predev:codegen",
    "predev:codegen": "npm-run-all codegen:i18n codegen:palette codegen:props codegen:wgsl",
    "dev": "run-p watch:i18n watch:props watch:wgsl dev:next",
    "dev:next": "next dev --turbopack -p $(node ../../scripts/get-worktree-port.mjs)",
    "build": "TURBO_TASKS_AVAILABLE_PARALLELISM=2 next build && serwist build serwist.config.mjs",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm-run-all codegen:i18n codegen:palette codegen:props codegen:wgsl",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:serve": "PORT=$(node ../../scripts/get-worktree-port.mjs) tsx e2e/serve-e2e.ts",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:dev": "vitest --config vitest.eval.config.mts",
    "ingest:vector": "tsx ../../packages/vector-ingest/src/ingest.ts",
    "verify:vector": "tsx ../../packages/vector-ingest/src/verify.ts"
  },
  "dependencies": {
    "@1771technologies/lytenyte-pro": "^2.2.1",
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/react": "^4.0.161",
    "@phosphor-icons/react": "catalog:",
    "@serwist/next": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "5.105.0",
    "@tuja/i18n": "workspace:*",
    "@tuja/tmdb-types": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@upstash/vector": "catalog:",
    "ai": "^7.0.157",
    "next": "catalog:",
    "posthog-js": "^1.438.24",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-remove-scroll": "catalog:",
    "react-virtuoso": "^4.18.19",
    "remark-gfm": "^4.0.1",
    "serwist": "catalog:",
    "sharp": "^0.35.5",
    "twgl.js": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/runtime": "^8.0.8",
    "@playwright/test": "^1.64.1",
    "@serwist/cli": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/props-codegen": "workspace:*",
    "@tuja/pwa-icons": "workspace:*",
    "@tuja/system-palette-codegen": "workspace:*",
    "@tuja/tmdb-codegen": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@tuja/vector-ingest": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "msw": "^3.0.3",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "prettier": "catalog:",
    "raw-loader": "^4.0.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
