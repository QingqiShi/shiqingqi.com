{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --watch",
    "watch:props": "tsx ../../packages/props-codegen/src/generator.ts --watch",
    "prebuild": "npm-run-all codegen:pwa-icons codegen:i18n codegen:palette codegen:props",
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts",
    "codegen:palette": "node --experimental-strip-types --no-warnings ../../packages/system-palette-codegen/src/generator.ts && prettier '../../packages/ui/src/_generated/palette/**/*.ts' -w",
    "codegen:props": "tsx ../../packages/props-codegen/src/generator.ts",
    "codegen:pwa-icons": "node ../../packages/pwa-icons/src/generate-hashed-icons.mjs",
    "codegen:tmdb": "node ../../packages/tmdb-codegen/src/generator.js && prettier 'src/_generated/*.ts' -w",
    "openapi:generate": "openapi-typescript https://developer.themoviedb.org/openapi/tmdb-api.json -o ../../packages/tmdb-types/src/openapi.d.ts && prettier '../../packages/tmdb-types/src/openapi.d.ts' -w",
    "predev": "npm-run-all codegen:i18n codegen:palette codegen:props",
    "dev": "run-p watch:i18n watch:props dev:next",
    "dev:next": "next dev --turbopack -p $(node ../../scripts/get-worktree-port.mjs)",
    "build": "TURBO_TASKS_AVAILABLE_PARALLELISM=2 next build && serwist build serwist.config.mjs",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "npm-run-all codegen:i18n codegen:palette codegen:props",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:dev": "vitest --config vitest.eval.config.mts",
    "ingest:vector": "tsx ../../packages/vector-ingest/src/ingest.ts",
    "verify:vector": "tsx ../../packages/vector-ingest/src/verify.ts",
    "finance:db": "tsx src/finance/db/dev/serve-dev-db.ts --port $(node ../../scripts/get-worktree-port.mjs 2433)",
    "finance:generate": "drizzle-kit generate",
    "finance:migrate": "drizzle-kit migrate",
    "finance:import": "tsx src/finance/import/moneythings/cli.ts",
    "finance:seed": "tsx src/finance/dev/seed/cli.ts",
    "finance:reports:backfill": "tsx src/finance/reports/backfill-cli.ts"
  },
  "dependencies": {
    "@1771technologies/lytenyte-pro": "^2.2.1",
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/react": "^4.0.133",
    "@phosphor-icons/react": "catalog:",
    "@serwist/next": "catalog:",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "5.104.1",
    "@tuja/tmdb-types": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@upstash/vector": "catalog:",
    "@vercel/functions": "^3.9.11",
    "ai": "^7.0.130",
    "drizzle-orm": "^0.45.4",
    "next": "catalog:",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-remove-scroll": "catalog:",
    "react-virtuoso": "^4.18.16",
    "remark-gfm": "^4.0.1",
    "serwist": "catalog:",
    "sharp": "^0.35.5",
    "twgl.js": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/runtime": "^8.0.5",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "catalog:",
    "@serwist/cli": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/props-codegen": "workspace:*",
    "@tuja/pwa-icons": "workspace:*",
    "@tuja/stylex-testing": "workspace:*",
    "@tuja/system-palette-codegen": "workspace:*",
    "@tuja/tmdb-codegen": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@tuja/vector-ingest": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "msw": "^3.0.2",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.6.1",
    "prettier": "catalog:",
    "raw-loader": "^4.0.2",
    "react-grab": "^0.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
