{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = preview ] || [ \"$VERCEL_ENV\" = production ]; then pnpm assistant:migrate; fi && turbo run build",
  "ignoreCommand": "npx turbo-ignore assistant",
  "crons": [
    {
      "path": "/api/cron/organise",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/morning-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/todo-calendar",
      "schedule": "*/30 * * * *"
    }
  ]
}
