{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "codegen": "npm-run-all codegen:*",
    "codegen:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root .",
    "codegen:wgsl": "node --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "watch:i18n": "tsx ../../packages/i18n-codegen/src/generator.ts --root . --watch",
    "watch:wgsl": "node --watch --experimental-strip-types --no-warnings ../../packages/ui/codegen/generate-wgsl.ts",
    "fonts": "node ../../scripts/fetch-licensed-fonts.mjs",
    "prebuild": "run-p fonts codegen:i18n codegen:wgsl",
    "predev": "run-p \"fonts -- --dev\" codegen:i18n codegen:wgsl",
    "dev": "run-p watch:i18n watch:wgsl dev:next",
    "dev:next": "tsx src/assistant/dev/run-with-local-assistant.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2533) -- next dev --turbopack -p ${ASSISTANT_PORT:-$(node ../../scripts/get-worktree-port.mjs 300)}",
    "build": "next build && serwist build serwist.config.mjs",
    "build:tsc": "next typegen && tsc --noEmit",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm-run-all codegen:i18n codegen:wgsl",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.mts",
    "assistant:generate": "drizzle-kit generate",
    "assistant:migrate": "tsx src/assistant/db/migrate-cli.ts",
    "assistant:invite-link": "tsx src/assistant/auth/invite-link-cli.ts",
    "assistant:session": "tsx src/assistant/dev/session/cli.ts --db-port $(node ../../scripts/get-worktree-port.mjs 2533) --app-port ${ASSISTANT_PORT:-$(node ../../scripts/get-worktree-port.mjs 300)}"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@phosphor-icons/react": "catalog:",
    "@serwist/next": "catalog:",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@stylexjs/stylex": "catalog:",
    "@tuja/i18n": "workspace:*",
    "@tuja/ui": "workspace:*",
    "@vercel/functions": "^3.10.3",
    "ai": "^7.0.154",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.10.0",
    "next": "catalog:",
    "pg": "^8.23.1",
    "postal-mime": "^4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "serwist": "catalog:",
    "tsdav": "2.5.0",
    "web-push": "3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@electric-sql/pglite": "0.5.12",
    "@next/env": "catalog:",
    "@serwist/cli": "catalog:",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@tuja/babel-plugins": "workspace:*",
    "@tuja/i18n-codegen": "workspace:*",
    "@tuja/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "^0.31.11",
    "jsdom": "catalog:",
    "modern-normalize": "^3.0.1",
    "next-i18n-router": "^5.5.8",
    "npm-run-all2": "^9.0.4",
    "pg-connection-string": "^2.14.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
