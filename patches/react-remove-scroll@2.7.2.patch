--- a/dist/es2015/SideEffect.js
+++ b/dist/es2015/SideEffect.js
@@ -89,6 +89,14 @@ export function RemoveScrollSideCar(props) {
             // not the last active
             return;
         }
+        // A touch that stays this near to its start is a tap. If its touchmove is
+        // cancelled, iOS 27 does not send the click of the tap.
+        if (event.type === 'touchmove' && event.touches.length === 1) {
+            var tapTouch = getTouchXY(event);
+            if (Math.abs(touchStartRef.current[0] - tapTouch[0]) < 4 && Math.abs(touchStartRef.current[1] - tapTouch[1]) < 4) {
+                return;
+            }
+        }
         var delta = 'deltaY' in event ? getDeltaXY(event) : getTouchXY(event);
         var sourceEvent = shouldPreventQueue.current.filter(function (e) { return e.name === event.type && (e.target === event.target || event.target === e.shadowParent) && deltaCompare(e.delta, delta); })[0];
         // self event, and should be canceled
