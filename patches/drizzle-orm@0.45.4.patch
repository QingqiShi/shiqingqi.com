+// Patched: the error of a failed query does not hold the values of the query.
+// Next.js writes an error that is not caught to the server log, with its
+// cause and its fields. The parameters, and the detail and message of the
+// database error, can hold user data. Thus the error keeps only the SQL text,
+// and the cause keeps only the fields that identify the error. The cause
+// keeps the message of the database only for the codes in SAFE_MESSAGE_CODES:
+// for these codes, the messages of Postgres name only constraints, tables
+// and columns. Other codes can show a value, for example 22P02 and 42P01
+// ("relation "<value>" does not exist" for `$1::regclass`). A RAISE with
+// one of these codes must not write values into its message.
+const SAFE_CAUSE_FIELDS = ["code", "severity", "schema", "table", "column", "dataType", "constraint", "routine"];
+const SAFE_MESSAGE_CODES = ["23502", "23503", "23505", "23514", "23P01", "42501"];
+function safeCauseOf(cause) {
+  if (typeof cause !== "object" || cause === null) return void 0;
+  const isDatabaseError = typeof cause.severity === "string";
+  const code = typeof cause.code === "string" ? cause.code : void 0;
+  const keepsMessage = typeof cause.message === "string" && (!isDatabaseError || SAFE_MESSAGE_CODES.includes(code));
+  const safe = new Error(keepsMessage ? cause.message : `The database refused the query (SQLSTATE ${code ?? "unknown"}).`);
+  safe.name = isDatabaseError ? "DatabaseError" : typeof cause.name === "string" ? cause.name : "Error";
+  for (const field of SAFE_CAUSE_FIELDS) {
+    if (typeof cause[field] === "string") safe[field] = cause[field];
+  }
+  safe.stack = `${safe.name}: ${safe.message}`;
+  return safe;
+}
 class DrizzleQueryError extends Error {
   constructor(query, params, cause) {
-    super(`Failed query: ${query}
-params: ${params}`);
+    super(`Failed query: ${query}`);
     this.query = query;
-    this.params = params;
-    this.cause = cause;
     Error.captureStackTrace(this, DrizzleQueryError);
-    if (cause) this.cause = cause;
+    const safeCause = safeCauseOf(cause);
+    if (safeCause) this.cause = safeCause;
   }
